# Settings of the lab. Copy to lab.env and edit. Everything is optional: with
# an empty lab.env the lab runs plain ironcore-in-a-box with storage.

## The Ceph build under test ##################################################

# RPM based Ceph container image (el9 or el10) whose librbd the volume
# provider is built against and runs with.
# The defaults are the upstream release. Replace both with the image and the
# RPM repository of the build you were given.
# An image that needs a login: log in and pull it on the host first, the lab
# then uses the local copy.
CEPH_IMAGE=quay.io/ceph/ceph:v21.2.0
# RPM repository of the same build. It must contain <arch>/librbd-devel and
# <arch>/librados-devel in the version of the image.
# A build from Clyso's build system has one repository per architecture (the
# URL ends in el10-<arch>.clyso) and may have one image tag per architecture,
# so both values can differ between x86_64 and aarch64 hosts.
CEPH_REPO_URL=https://download.ceph.com/rpm-21.2.0/el10
# Signing key of that repository. Empty turns the signature check off.
CEPH_REPO_GPGKEY=https://download.ceph.com/keys/release.asc
# Platform of the build, in Docker's notation, when it differs from the host,
# for example linux/amd64 for an x86_64 build on an Apple silicon Mac or an
# arm64 Linux host. The volume provider then runs through emulation, which is
# slow. A Linux host needs the emulation registered first:
#   docker run --privileged --rm tonistiigi/binfmt --install amd64
#CEPH_PLATFORM=linux/amd64
# CPU limit of the provider container. Empty keeps the 200m of
# ironcore-in-a-box, or 2 when CEPH_PLATFORM is set. More CPU makes new
# volumes cost more memory at every open (README, "CPU and memory of the
# provider belong together").
#CEPH_VOLUME_PROVIDER_CPU=

# Image of the Ceph cluster that Rook runs. Empty keeps the ironcore-in-a-box
# default. librbd is a client library, so the cluster does not have to run the
# build under test.
#CEPH_CLUSTER_IMAGE=

## Components built from a local checkout #####################################

# ceph-provider checkout for "./lab build-ceph-volume-provider".
#CEPH_PROVIDER_DIR=/path/to/ceph-provider
# go-ceph build tags, for example ceph_preview.
#CEPH_PROVIDER_GO_BUILD_TAGS=

## Images to run instead of the pinned upstream ones ##########################

# An image that exists in the local Docker is loaded into the kind node,
# anything else is pulled by the node. "./lab deploy" rolls them out.
#CEPH_VOLUME_PROVIDER_IMAGE=lab/ceph-volume-provider:dev
#VOLUMEPOOLLET_IMAGE=
#LIBVIRT_PROVIDER_IMAGE=
#MACHINEPOOLLET_IMAGE=
#IRONCORE_APISERVER_IMAGE=
#IRONCORE_CONTROLLER_MANAGER_IMAGE=

## Other ######################################################################

# Size of the sparse file behind the single OSD.
#LAB_OSD_SIZE=10G
